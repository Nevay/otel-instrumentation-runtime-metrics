{
    "name": "tbachert/otel-instrumentation-runtime-metrics",
    "description": "Generates php runtime metrics for OpenTelemetry",
    "keywords": ["opentelemetry", "otel"],
    "license": "Apache-2.0",
    "require": {
        "php": "^8.1",
        "composer-runtime-api": "^2.0",
        "open-telemetry/api": "^1.4"
    },
    "require-dev": {
        "ext-pcntl": "*",
        "symfony/dotenv": "^7.3",
        "symfony/yaml": "^7.3",
        "tbachert/otel-sdk": "^0.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "tbachert/spi": true
        }
    },
    "autoload": {
        "psr-4": {
            "Nevay\\OTelInstrumentation\\RuntimeMetrics\\": "src/"
        },
        "files": [
            "_register.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "spi-config": {
            "autoload-files": true
        }
    }
}
